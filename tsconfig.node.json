{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "isolatedModules": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // Scripts run with Node's built-in type stripping, which rejects enums, parameter
    // properties and other syntax that needs transforming.
    "erasableSyntaxOnly": true
  },
  "include": [
    "vite.config.ts",
    "pwa-assets.config.ts",
    "eslint.config.js",
    "commitlint.config.js",
    "scripts",
    "app/src/catalog/types.ts",
    "app/src/calendar/ics.ts",
    "app/teste-calendario/feed.ts"
  ]
}
