{
  "name": "lunario",
  "version": "0.2.0",
  "private": true,
  "description": "A rural almanac in your pocket: moon phases, local weather and a Portuguese sowing calendar by region.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "catalog": "node scripts/build-catalog.ts",
    "predev": "npm run catalog",
    "dev": "vite",
    "prebuild": "npm run catalog",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretypecheck": "npm run catalog",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "pretest": "npm run catalog",
    "test": "vitest run",
    "pretest:watch": "npm run catalog",
    "test:watch": "vitest",
    "pretest:coverage": "npm run catalog",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "astronomy-engine": "2.1.19",
    "i18next": "^27.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
